# Vite automatically loads this file only when mode === "test" (Vitest's default mode).
# It is NEVER used by `npm run dev` or `npm run build` (development/production modes).
#
# These are placeholder values so src/lib/supabase.ts can construct a real
# SupabaseClient object during unit tests (so tests can `vi.spyOn(supabase.functions, ...)`).
# No network call is ever made to this host in the test suite — all Supabase calls are mocked.
# This is not a real project and must never be used outside this repo's test runner.
VITE_SUPABASE_URL=https://pdds-test-placeholder.supabase.co
VITE_SUPABASE_ANON_KEY=test-placeholder-anon-key-not-a-real-credential
