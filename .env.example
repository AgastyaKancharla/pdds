# ─── Database ────────────────────────────────────────────
DATABASE_URL=postgresql://pdds_user:pdds_secret@localhost:5432/pdds
MONGO_URL=mongodb://pdds_user:pdds_secret@localhost:27017/pdds?authSource=admin
REDIS_URL=redis://localhost:6379

# ─── Auth ────────────────────────────────────────────────
JWT_SECRET=your_jwt_secret_here_min_32_chars
JWT_EXPIRES_IN=7d
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ─── AI Services ─────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key
PINECONE_API_KEY=your_pinecone_api_key
PINECONE_INDEX=pdds-knowledge-base

# ─── Storage ─────────────────────────────────────────────
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1
AWS_S3_BUCKET=pdds-plant-images

# ─── ML Model ────────────────────────────────────────────
MODEL_PATH=./ml/models/efficientnet_b4_plant.pt
CONFIDENCE_THRESHOLD=0.60

# ─── Service URLs ─────────────────────────────────────────
DETECTION_SERVICE_URL=http://localhost:8001
CHAT_SERVICE_URL=http://localhost:8002
EDUCATION_SERVICE_URL=http://localhost:3002
HISTORY_SERVICE_URL=http://localhost:3003

# ─── Next.js Frontend ────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── Supabase ────────────────────────────────────────────
SUPABASE_URL=your_supabase_project_url
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_KEY=your_supabase_service_key
